<UserControl x:Class="ExitEcho.App.StatusStepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="17" MinWidth="190" Loaded="OnLoaded" Unloaded="OnUnloaded">
  <Grid FlowDirection="{DynamicResource LocalFlowDirection}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
      <TextBlock x:Name="DetectedLabel" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                 Margin="6,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid Grid.Column="1" Height="1.5" Margin="9,0" VerticalAlignment="Center">
      <Border x:Name="LineReveal" Background="{DynamicResource MutedBrush}" Opacity="0.45"
              RenderTransformOrigin="0,0.5">
        <Border.RenderTransform><ScaleTransform ScaleX="1"/></Border.RenderTransform>
      </Border>
      <Border x:Name="AccentProgress" Background="{DynamicResource AccentBrush}"
              RenderTransformOrigin="0,0.5">
        <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
      </Border>
    </Grid>
    <StackPanel x:Name="ActionVisual" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Grid Width="10" Height="10" VerticalAlignment="Center" IsHitTestVisible="False">
        <Ellipse x:Name="PendingDot" Width="7" Height="7" Stroke="{DynamicResource MutedBrush}"
                 StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Path x:Name="CompletedMark" Data="{StaticResource IconHistoryEnded}" Stroke="{DynamicResource SuccessBrush}"
              Width="10" Height="10" Stretch="Uniform" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform><ScaleTransform/></Path.RenderTransform>
        </Path>
      </Grid>
      <Grid Margin="5,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="PendingLabel" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock x:Name="EndedLabel" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Opacity="0"/>
        <TextBlock x:Name="IgnoredLabel" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" Opacity="0"/>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
