<Window x:Class="ExitEcho.App.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ExitEcho.App"
        Title="{DynamicResource L_NotificationTitle}" Icon="/Assets/ExitEcho.ico" Width="438" Height="200" FlowDirection="{DynamicResource LocalFlowDirection}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" ShowActivated="False">
  <Window.Resources>
    <Style x:Key="NoticeAction" TargetType="Button">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
              <Grid>
                <Border x:Name="HoverSurface" Background="{DynamicResource HoverBrush}" CornerRadius="6" Opacity="0"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                   To="1" Duration="0:0:0.14"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity"
                                   To="0" Duration="0:0:0.14"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                  <Condition Binding="{Binding Enabled, Source={x:Static app:MotionPreferences.Current}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="ActionSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.09"/>
                  <DoubleAnimation Storyboard.TargetName="ActionSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.09"/>
                </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="ActionSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="ActionSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Canvas Width="88" Height="83" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
      <Border x:Name="PreludeBack" Canvas.Left="22" Canvas.Top="10" Width="64" Height="47"
              BorderBrush="{DynamicResource EchoBackBrush}" BorderThickness="1" CornerRadius="7" Opacity="0">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      </Border>
      <Border x:Name="PreludeMiddle" Canvas.Left="13" Canvas.Top="18" Width="64" Height="47"
              BorderBrush="{DynamicResource EchoMiddleBrush}" BorderThickness="1" CornerRadius="7" Opacity="0">
        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      </Border>
      <Border x:Name="PreludeWindow" Canvas.Left="3" Canvas.Top="27" Width="64" Height="47"
              BorderBrush="{DynamicResource EchoFrontBrush}" BorderThickness="1.5" CornerRadius="7" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <Grid>
          <Border Height="1" Background="{DynamicResource EchoMiddleBrush}" VerticalAlignment="Top" Margin="0,12,0,0"/>
          <TextBlock Text="•••" Foreground="{DynamicResource EchoFrontBrush}" FontSize="10" Margin="8,-2,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>
      </Border>
    </Canvas>
    <Border x:Name="ToastCard" Margin="12" Padding="15" Background="{DynamicResource NotificationBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Opacity="0"
            RenderTransformOrigin="0.5,0.5">
      <Border.Effect><DropShadowEffect Color="#09131B" BlurRadius="15" ShadowDepth="4" Opacity="0.16"/></Border.Effect>
      <Border.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="ToastScale" ScaleX="0.982" ScaleY="0.982"/>
          <TranslateTransform x:Name="ToastSlide" Y="5"/>
        </TransformGroup>
      </Border.RenderTransform>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="94"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/Assets/logo-20.png" Width="19" Height="19" Margin="0,0,9,0"
                 RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"/>
          <TextBlock Text="{DynamicResource L_Brand}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,5,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Canvas Width="88" Height="83" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False">
            <Border x:Name="EchoBack" Canvas.Left="23" Canvas.Top="8" Width="63" Height="47"
                    BorderBrush="{DynamicResource EchoBackBrush}" BorderThickness="1" CornerRadius="7" Opacity="0">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            </Border>
            <Border x:Name="EchoMiddle" Canvas.Left="13" Canvas.Top="17" Width="63" Height="47"
                    BorderBrush="{DynamicResource EchoMiddleBrush}" BorderThickness="1" CornerRadius="7" Opacity="0">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            </Border>
            <Border Canvas.Left="3" Canvas.Top="26" Width="63" Height="47" Background="{DynamicResource EchoFrontFillBrush}"
                    BorderBrush="{DynamicResource EchoFrontBrush}" BorderThickness="1.7" CornerRadius="7">
              <Grid>
                <Border Height="1" Background="{DynamicResource EchoMiddleBrush}" VerticalAlignment="Top" Margin="0,12,0,0"/>
                <TextBlock Text="•••" Foreground="{DynamicResource EchoFrontBrush}" FontSize="10" Margin="8,-2,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border Width="17" Height="17" Background="{DynamicResource SecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0">
                  <Grid>
                    <Path x:Name="AppIconFallback" Data="{StaticResource IconAppWindow}" Stroke="{DynamicResource TextBrush}"
                          Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="AppIcon" Width="15" Height="15" Stretch="Uniform" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Canvas>
          <StackPanel x:Name="TextContent" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0">
            <TextBlock x:Name="AppNameText" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="CountText" FlowDirection="LeftToRight" Text="0" Foreground="{DynamicResource TextBrush}" FontSize="12.5" FontWeight="SemiBold"/>
              <TextBlock x:Name="ProcessText" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
              <TextBlock x:Name="RamText" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" Opacity="0"/>
              <StackPanel x:Name="DetectedStatus" Orientation="Horizontal" Margin="13,0,0,0" Opacity="0">
                <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="{DynamicResource L_DetectedJustNow}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Style="{StaticResource NoticeAction}" Click="OnIgnore" AutomationProperties.Name="{DynamicResource L_Ignore}" Margin="0,0,7,0">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconIgnored}" Stroke="{DynamicResource TextBrush}" Width="15" Height="15"
                    Stretch="Uniform" Margin="0,0,5,0"/>
              <TextBlock Text="{DynamicResource L_Ignore}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource NoticeAction}" Click="OnDetails" AutomationProperties.Name="{DynamicResource L_Details}"
                  MouseEnter="OnDetailsEnter" MouseLeave="OnDetailsLeave">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource L_Details}" Foreground="{DynamicResource TextBrush}"/>
              <Path x:Name="DetailsArrow" Data="{StaticResource IconChevron}" Stroke="{DynamicResource MutedBrush}" Width="15" Height="15"
                    Stretch="Uniform" Margin="5,0,0,0" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><TransformGroup><RotateTransform Angle="-90"/><TranslateTransform/></TransformGroup></Path.RenderTransform>
              </Path>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
