<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ExitEcho</AssemblyName>
    <ApplicationIcon>..\assets\ExitEcho.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExitEcho.Core\ExitEcho.Core.csproj" />
    <Resource Include="..\assets\ExitEcho.ico" Link="Assets\ExitEcho.ico" />
    <Resource Include="..\assets\logo-*.png" Link="Assets\%(Filename)%(Extension)" />
    <Resource Include="Localization\strings.*.json" />
  </ItemGroup>
</Project>
