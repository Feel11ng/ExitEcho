<Window x:Class="ExitEcho.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ExitEcho.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource L_Brand}" Icon="/Assets/ExitEcho.ico" Width="500" Height="470" MinWidth="500" MinHeight="470" FlowDirection="{DynamicResource LocalFlowDirection}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Style="{StaticResource UtilityWindowStyle}"
        Closing="OnClosing">
  <Window.Resources>
    <Style x:Key="EchoOutline" TargetType="ContentControl">
      <Setter Property="Width" Value="143"/><Setter Property="Height" Value="91"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="ContentControl">
          <Border CornerRadius="11" BorderBrush="{TemplateBinding Foreground}" BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}">
            <Grid>
              <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="0,1,0,0"
                      VerticalAlignment="Top" Margin="0,23,0,0" Opacity="0.48"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="12,9,0,0" Opacity="0.58">
                <Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" Margin="0,0,5,0"/>
                <Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}" Margin="0,0,5,0"/>
                <Ellipse Width="5" Height="5" Fill="{TemplateBinding Foreground}"/>
              </StackPanel>
            </Grid>
          </Border>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ConceptButton" TargetType="Button">
      <Setter Property="app:MotionPreferences.EnabledForControl" Value="{Binding Enabled, Source={x:Static app:MotionPreferences.Current}}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shell" BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}" BorderThickness="0.8" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
          <Grid>
            <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}" CornerRadius="8" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsPressed" Value="True"/>
              <Condition Property="app:MotionPreferences.EnabledForControl" Value="True"/>
            </MultiTrigger.Conditions>
            <MultiTrigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.09"/>
              <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.09"/>
            </Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
            <MultiTrigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
              <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
            </Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
          </MultiTrigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="0.7"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ConceptSectionButton" TargetType="Button">
      <Setter Property="app:MotionPreferences.EnabledForControl" Value="{Binding Enabled, Source={x:Static app:MotionPreferences.Current}}"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
          <Grid>
            <Border x:Name="HoverLayer" Background="{DynamicResource HoverBrush}" CornerRadius="8" Opacity="0"/>
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsPressed" Value="True"/>
              <Condition Property="app:MotionPreferences.EnabledForControl" Value="True"/>
            </MultiTrigger.Conditions>
            <MultiTrigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.09"/>
              <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.09"/>
            </Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
            <MultiTrigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
              <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
            </Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
          </MultiTrigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverLayer" Property="Opacity" Value="0.7"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource MainBackgroundBrush}" ClipToBounds="True">
    <Grid Height="64" Margin="27,0,27,0" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Image Source="/Assets/logo-24.png" Width="24" Height="24" Margin="0,0,10,0"
               RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"/>
        <TextBlock Text="{DynamicResource L_Brand}" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource ConceptSectionButton}" Width="28" Height="28" Margin="0,0,13,0"
                Click="OnOpenSettings" ToolTip="{DynamicResource L_TraySettings}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                AutomationProperties.Name="{DynamicResource L_TraySettings}">
          <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource MutedBrush}" Width="17" Height="17" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Grid Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
          <Ellipse x:Name="MonitoringDot" Fill="{DynamicResource SuccessBrush}"/>
          <Ellipse x:Name="PausedDot" Fill="{DynamicResource MutedBrush}" Opacity="0"/>
        </Grid>
        <Grid Margin="0,0,8,0" VerticalAlignment="Center">
          <TextBlock x:Name="HeaderMonitoringText" Text="{DynamicResource L_Monitoring}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
          <TextBlock x:Name="HeaderPausedText" Text="{DynamicResource L_Paused}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold" Opacity="0"/>
        </Grid>
        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="30" Click="OnMainMinimize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource L_Minimize}"
                AutomationProperties.Name="{DynamicResource L_Minimize}">
          <Path Data="{StaticResource IconMinimize}" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform"/>
        </Button>
        <Button x:Name="MainMaximizeButton" Style="{StaticResource IconButtonStyle}" Width="34" Height="30" Click="OnMainMaximize"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource L_Maximize}"
                AutomationProperties.Name="{DynamicResource L_Maximize}">
          <Grid Width="16" Height="16" IsHitTestVisible="False">
            <Path x:Name="MainMaximizeIcon" Data="{StaticResource IconMaximize}" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><ScaleTransform/></Path.RenderTransform>
            </Path>
            <Path x:Name="MainMaximizeIncomingIcon" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform" Opacity="0" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><ScaleTransform/></Path.RenderTransform>
            </Path>
          </Grid>
        </Button>
        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="30" Click="OnMainClose"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource L_Close}"
                AutomationProperties.Name="{DynamicResource L_Close}">
          <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform"/>
        </Button>
      </StackPanel>
    </Grid>

    <Grid x:Name="MainContent" Width="500" Height="470" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True">
    <StackPanel Margin="0,71,0,0" VerticalAlignment="Top" HorizontalAlignment="Center">
      <Canvas x:Name="EchoContainer" Width="220" Height="108" RenderTransformOrigin="0.5,0.5">
        <Canvas.RenderTransform><ScaleTransform ScaleX="0.72" ScaleY="0.72"/></Canvas.RenderTransform>
        <ContentControl x:Name="EchoBack" Style="{StaticResource EchoOutline}" Canvas.Left="77" Canvas.Top="-3"
                        Foreground="{DynamicResource EchoBackBrush}" Background="Transparent" Opacity="0.05">
          <ContentControl.RenderTransform><TranslateTransform x:Name="EchoBackTranslate" X="-17" Y="10"/></ContentControl.RenderTransform>
        </ContentControl>
        <ContentControl x:Name="EchoMid" Style="{StaticResource EchoOutline}" Canvas.Left="52" Canvas.Top="12"
                        Foreground="{DynamicResource EchoMiddleBrush}" Background="Transparent" Opacity="0.1">
          <ContentControl.RenderTransform><TranslateTransform x:Name="EchoMidTranslate" X="-12" Y="6"/></ContentControl.RenderTransform>
        </ContentControl>
        <ContentControl x:Name="EchoFront" Style="{StaticResource EchoOutline}" Canvas.Left="28" Canvas.Top="30"
                        Foreground="{DynamicResource EchoFrontBrush}" Background="{DynamicResource EchoFrontFillBrush}" BorderThickness="2">
          <ContentControl.RenderTransform><TranslateTransform x:Name="EchoFrontTranslate"/></ContentControl.RenderTransform>
        </ContentControl>
      </Canvas>
      <Grid HorizontalAlignment="Center" Margin="0,4,0,0">
        <TextBlock x:Name="MonitoringText" Text="{DynamicResource L_MainMonitoring}" Foreground="{DynamicResource TextBrush}"
                   FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center">
          <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="PausedText" Text="{DynamicResource L_MainPaused}" Foreground="{DynamicResource TextBrush}"
                   FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0">
          <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
        </TextBlock>
      </Grid>
      <Grid Width="350" HorizontalAlignment="Center" Margin="0,8,0,0">
        <TextBlock x:Name="MonitoringSubtitle" Text="{DynamicResource L_MainWatchSubtitle}"
                   Foreground="{DynamicResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center">
          <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="PausedSubtitle" Text="{DynamicResource L_MainPauseSubtitle}"
                   Foreground="{DynamicResource MutedBrush}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Opacity="0">
          <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
        </TextBlock>
      </Grid>
    </StackPanel>

    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,250,0,0">
      <TextBlock x:Name="EventCountText" Text="0" Foreground="{DynamicResource TextBrush}" FontSize="30"
                 FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center">
        <TextBlock.RenderTransform><TranslateTransform x:Name="EventCountTranslate"/></TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock x:Name="SessionCountLabel" Text="{DynamicResource L_MainSessionCount}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                 TextAlignment="Center"/>
    </StackPanel>

    <Button Height="49" Margin="27,307,27,0" VerticalAlignment="Top" Style="{StaticResource ConceptSectionButton}"
            Click="OnOpenHistory" AutomationProperties.Name="{DynamicResource L_RecentLeftovers}">
      <Grid Margin="8,0,8,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource L_RecentLeftovers}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5"/>
        <Path Grid.Column="1" Data="{StaticResource IconChevron}" Stroke="{DynamicResource MutedBrush}" Width="14" Height="14"
              Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform>
        </Path>
        <Grid x:Name="RecentActivityRow" Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="RecentAppText" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}"
                   FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,10,0"/>
        <TextBlock x:Name="RecentMetaText" Grid.Column="1" Foreground="{DynamicResource MutedBrush}"
                   FontSize="11.5" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Margin="0,3,0,0"/>
        <Grid.RenderTransform><TranslateTransform x:Name="RecentActivityTranslate"/></Grid.RenderTransform>
        </Grid>
      </Grid>
    </Button>

    <Grid Margin="27,365,27,0" VerticalAlignment="Top">
      <Button x:Name="IgnoredToggle" Height="36" VerticalAlignment="Top" Style="{StaticResource ConceptSectionButton}"
              Click="OnIgnoredToggle" AutomationProperties.Name="{DynamicResource L_IgnoredApps}">
        <Grid Margin="8,0,8,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Path Data="{StaticResource IconIgnored}" Stroke="{DynamicResource MutedBrush}" Width="17" Height="17" Stretch="Uniform" Margin="0,0,9,0"/>
            <TextBlock Text="{DynamicResource L_IgnoredApps}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="IgnoredCountText" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,0" Visibility="Collapsed"/>
          <Path Data="{StaticResource IconChevron}" Stroke="{DynamicResource MutedBrush}" Width="16" Height="16" Stretch="Uniform"
                HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><RotateTransform x:Name="IgnoredChevronRotate"/></Path.RenderTransform>
          </Path>
        </Grid>
      </Button>
      <Grid x:Name="IgnoredContent" Margin="8,36,8,0" Height="0" Opacity="0" VerticalAlignment="Top" ClipToBounds="True">
        <TextBlock x:Name="EmptyState" Text="{DynamicResource L_NoIgnoredApps}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" VerticalAlignment="Top"/>
        <StackPanel x:Name="IgnoredListPanel" Visibility="Collapsed">
          <ListBox x:Name="IgnoredList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                   MaxHeight="80" ItemContainerStyle="{StaticResource ListRowStyle}" SelectionChanged="OnIgnoredSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button x:Name="RemoveButton" Content="{DynamicResource L_RemoveSelected}" Style="{StaticResource ConceptButton}"
                  MinWidth="118" Padding="12,0" Height="30" Margin="0,5,0,0" HorizontalAlignment="Left" Click="OnRemoveIgnored"
                  AutomationProperties.Name="{DynamicResource L_RemoveSelected}"/>
        </StackPanel>
      </Grid>
    </Grid>

    <Button x:Name="PauseButton" MinWidth="134" Padding="12,0" Height="30" Margin="27,0,0,18" VerticalAlignment="Bottom" HorizontalAlignment="Left"
            Style="{StaticResource SkeuoQuietButtonStyle}" Click="OnPauseResume" AutomationProperties.Name="{DynamicResource L_PauseMonitoring}">
      <Grid>
        <StackPanel x:Name="PauseButtonContent" Orientation="Horizontal">
          <Path x:Name="PauseIcon" Data="{StaticResource IconPause}" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0">
            <Path.RenderTransform><ScaleTransform/></Path.RenderTransform>
          </Path>
          <TextBlock x:Name="PauseButtonText" Text="{DynamicResource L_PauseMonitoring}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel x:Name="ResumeButtonContent" Orientation="Horizontal" Opacity="0" IsHitTestVisible="False">
          <Path x:Name="PauseIncomingIcon" Data="{StaticResource IconResume}" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0">
            <Path.RenderTransform><ScaleTransform/></Path.RenderTransform>
          </Path>
          <TextBlock x:Name="ResumeButtonText" Text="{DynamicResource L_ResumeMonitoring}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Button>
    </Grid>
  </Grid>
</Window>
