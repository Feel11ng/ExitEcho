<Window x:Class="ExitEcho.App.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExitEcho details" Icon="/Assets/ExitEcho.ico" Width="470" MinWidth="470" MinHeight="250" MaxHeight="420"
        SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="AppTitle" Grid.Row="0" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="SummaryText" Grid.Row="2" Foreground="{DynamicResource MutedBrush}"/>
    <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
      <Grid Margin="12,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Process name" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="1" Text="PID" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="2" Text="RAM" FontWeight="SemiBold"/>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="180">
          <ItemsControl x:Name="ProcessesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Pid}"/>
                  <TextBlock Grid.Column="2" Text="{Binding RamText}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
    <Button Grid.Row="6" Content="End leftovers" Style="{StaticResource PrimaryButtonStyle}"
            HorizontalAlignment="Right" Click="OnEndLeftovers"/>
  </Grid>
</Window>
