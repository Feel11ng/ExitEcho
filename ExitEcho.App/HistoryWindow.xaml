<Window x:Class="ExitEcho.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExitEcho.App"
        Title="{DynamicResource L_HistoryTitle}" Icon="/Assets/ExitEcho.ico" Width="456" Height="420" FlowDirection="{DynamicResource LocalFlowDirection}"
        MinWidth="420" MinHeight="360" WindowStartupLocation="CenterScreen"
        Style="{StaticResource UtilityWindowStyle}" Background="{DynamicResource BackgroundBrush}">
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <local:ChromeTitleBar/>
    <Grid Grid.Row="1" Margin="21,16,21,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="35"/><RowDefinition Height="31"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource L_HistoryHeading}" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="SemiBold"
                 VerticalAlignment="Center"/>
      <TextBlock Grid.Row="1" Text="{DynamicResource L_HistoryDescription}"
                 Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"/>
      <StackPanel x:Name="EmptyState" Grid.Row="2" Margin="0,34,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
        <Path Data="{StaticResource IconLeftovers}" Stroke="{DynamicResource AccentBrush}" Width="24" Height="24"
              Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="{DynamicResource L_NoLeftovers}" Foreground="{DynamicResource TextBrush}" FontSize="14"
                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="{DynamicResource L_HistoryEmptyDescription}" Foreground="{DynamicResource MutedBrush}"
                   FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="HistoryList">
          <ItemsControl.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                             FontWeight="SemiBold" Margin="0,14,0,10"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ItemsControl.GroupStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="EventCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="9" Padding="14,12" Margin="0,0,0,8" Opacity="0"
                      Loaded="OnHistoryCardLoaded">
                <Border.RenderTransform><TranslateTransform Y="5"/></Border.RenderTransform>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                    <Path x:Name="AppIconFallback" Data="{StaticResource IconAppWindow}" Stroke="{DynamicResource MutedBrush}"
                          Width="19" Height="19" Stretch="Uniform" Visibility="Collapsed"/>
                    <Image Source="{Binding IconSource}" Width="20" Height="20" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <Grid>
                      <TextBlock Text="{Binding AppName}" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" FontSize="14.5"
                                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,62,0"/>
                      <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <TextBlock Text="{Binding ProcessCountText}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5"/>
                      <TextBlock Text="  ·  " Foreground="{DynamicResource MutedBrush}" FontSize="11.5"/>
                      <TextBlock Text="{Binding RamText}" FlowDirection="LeftToRight" Foreground="{DynamicResource TextBrush}" FontSize="11.5"/>
                    </StackPanel>
                    <local:StatusStepper Status="{Binding ActionStatus}" Margin="0,7,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IconSource}" Value="{x:Null}">
                <Setter TargetName="AppIconFallback" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="EventCard" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                <Setter TargetName="EventCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
