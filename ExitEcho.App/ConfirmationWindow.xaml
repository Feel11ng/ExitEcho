<Window x:Class="ExitEcho.App.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExitEcho.App"
        Title="{DynamicResource L_Brand}" Icon="/Assets/ExitEcho.ico" Width="390" Height="202" MinWidth="360" FlowDirection="{DynamicResource LocalFlowDirection}"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource UtilityWindowStyle}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <local:ChromeTitleBar/>
    <Grid Grid.Row="1" Margin="20,13,20,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource DangerBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,9,0"/>
        <TextBlock Text="{DynamicResource L_ConfirmationHeading}" FontSize="16" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock x:Name="MessageText" Grid.Row="2" Style="{StaticResource MutedTextStyle}" FontSize="13" TextWrapping="Wrap"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{DynamicResource L_Cancel}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnCancel"/>
        <Button Style="{StaticResource DangerButtonStyle}" Click="OnConfirm">
          <TextBlock Text="{DynamicResource L_EndLeftovers}" Foreground="{DynamicResource DangerButtonTextBrush}"/>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
