<Window x:Class="ExitEcho.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExitEcho.App"
        Title="{DynamicResource L_SettingsTitle}" Icon="/Assets/ExitEcho.ico" FlowDirection="{DynamicResource LocalFlowDirection}"
        Width="456" Height="620" MinWidth="430" MinHeight="565"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Style="{StaticResource UtilityWindowStyle}">
  <Window.Resources>
    <Style x:Key="SettingsRow" TargetType="Border">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Height" Value="46"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SettingsToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Width="42" Height="24">
              <Border x:Name="Track" Background="{DynamicResource BorderBrush}" CornerRadius="12"/>
              <Border x:Name="ActiveTrack" Background="{DynamicResource AccentBrush}" CornerRadius="12" Opacity="0"/>
              <Ellipse x:Name="ToggleThumb" Width="18" Height="18" Fill="{DynamicResource SurfaceBrush}"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ActiveTrack" Property="Opacity" Value="1"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="ToggleThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                   To="18" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="ToggleThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                   To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.78"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Margin="3,1">
          <ContentPresenter Margin="{TemplateBinding Padding}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SecondaryBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SecondaryBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsCombo" TargetType="ComboBox">
      <Setter Property="Width" Value="154"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboItem}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="8"/>
          <ContentPresenter Margin="11,0,28,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"
                            IsHitTestVisible="False"/>
          <Path Data="{StaticResource IconChevron}" Stroke="{DynamicResource MutedBrush}" Width="14" Height="14"
                Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
          <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                 AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="3" MinWidth="154" Margin="0,4,0,0">
              <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DelayBox" TargetType="TextBox">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
          <ScrollViewer x:Name="PART_ContentHost" Margin="3,0"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <local:ChromeTitleBar/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="21,16,21,23">
        <TextBlock Text="{DynamicResource L_SettingsHeading}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,19"/>
        <TextBlock Text="{DynamicResource L_General}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"
                   FontWeight="SemiBold" Margin="9,0,0,7"/>
        <Border Style="{StaticResource SettingsRow}">
          <Grid><TextBlock Text="{DynamicResource L_Language}" VerticalAlignment="Center" FontSize="13"/>
            <ComboBox x:Name="LanguageCombo" Style="{StaticResource SettingsCombo}" HorizontalAlignment="Right"
                      VerticalAlignment="Center" SelectionChanged="OnLanguageChanged">
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingsRow}">
          <Grid><TextBlock Text="{DynamicResource L_Theme}" VerticalAlignment="Center" FontSize="13"/>
            <ComboBox x:Name="ThemeCombo" Style="{StaticResource SettingsCombo}" HorizontalAlignment="Right"
                      VerticalAlignment="Center" SelectionChanged="OnThemeChanged"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingsRow}">
          <Grid><TextBlock Text="{DynamicResource L_StartWithWindows}" VerticalAlignment="Center" FontSize="13"/>
            <ToggleButton x:Name="StartupToggle" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource L_StartWithWindows}"
                          Click="OnStartupToggle"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingsRow}">
          <Grid><TextBlock Text="{DynamicResource L_ShowNotifications}" VerticalAlignment="Center" FontSize="13"/>
            <ToggleButton x:Name="NotificationsToggle" Style="{StaticResource SettingsToggle}" HorizontalAlignment="Right"
                          VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource L_ShowNotifications}"
                          Click="OnNotificationsToggle"/>
          </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="9,12,9,19"/>
        <TextBlock Text="{DynamicResource L_MonitoringSection}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"
                   FontWeight="SemiBold" Margin="9,0,0,7"/>
        <Border Style="{StaticResource SettingsRow}">
          <Grid><TextBlock Text="{DynamicResource L_NotificationDelay}" VerticalAlignment="Center" FontSize="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBox x:Name="DelayBox" Style="{StaticResource DelayBox}" FlowDirection="LeftToRight" MaxLength="2"
                       LostFocus="OnDelayCommit" KeyDown="OnDelayKeyDown"/>
              <TextBlock Text="{DynamicResource L_Seconds}" Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center" FontSize="12" Margin="7,0,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource SettingsRow}">
          <Grid><TextBlock Text="{DynamicResource L_IgnoredApps}" VerticalAlignment="Center" FontSize="13"/>
            <Button Content="{DynamicResource L_Manage}" Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnManageIgnored"/>
          </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="9,12,9,19"/>
        <TextBlock Text="{DynamicResource L_About}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5"
                   FontWeight="SemiBold" Margin="9,0,0,11"/>
        <StackPanel Margin="9,0,0,0">
          <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/logo-20.png" Width="20" Height="20" Margin="0,0,8,0"
                   RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"/>
            <TextBlock Text="{DynamicResource L_Brand}" FlowDirection="LeftToRight" FontSize="13"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,7,0,0"/>
          <TextBlock Text="{DynamicResource L_CreatedBy}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,4,0,0"/>
          <TextBlock Text="{DynamicResource L_MITLicense}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,4,0,0"/>
          <TextBlock Text="{DynamicResource L_PrivacyLabel}" Foreground="{DynamicResource TextBrush}" FontSize="11.5" Margin="0,11,0,0"/>
          <TextBlock Text="{DynamicResource L_PrivacyLocal}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
