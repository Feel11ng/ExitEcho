<UserControl x:Class="ExitEcho.App.ChromeTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="42">
  <Grid Background="{DynamicResource BackgroundBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
      <Image Source="/Assets/logo-16.png" Width="16" Height="16" Margin="0,0,8,0"
             RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"/>
      <TextBlock x:Name="TitleLabel" Text="{DynamicResource L_Brand}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
      <Button x:Name="MinimizeButton" Style="{StaticResource IconButtonStyle}" Width="34" Height="30"
              shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource L_Minimize}" AutomationProperties.Name="{DynamicResource L_Minimize}" Click="OnMinimize">
        <Path Data="{StaticResource IconMinimize}" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform"/>
      </Button>
      <Button x:Name="MaximizeButton" Style="{StaticResource IconButtonStyle}" Width="34" Height="30"
              shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource L_Maximize}" AutomationProperties.Name="{DynamicResource L_Maximize}" Click="OnMaximize">
        <Grid Width="16" Height="16" IsHitTestVisible="False">
          <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><ScaleTransform/></Path.RenderTransform>
          </Path>
          <Path x:Name="MaximizeIncomingIcon" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><ScaleTransform/></Path.RenderTransform>
          </Path>
        </Grid>
      </Button>
      <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="30"
              shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource L_Close}" AutomationProperties.Name="{DynamicResource L_Close}" Click="OnClose">
        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
